{
  "expo": {
    "name": "freshkeep",
    "slug": "freshkeep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freshkeep",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSFaceIDUsageDescription": "FreshKeep can lock the app behind Face ID so only you can see your list."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.chiraggincerro.freshkeep"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "FreshKeep uses the camera to scan printed expiry dates."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FreshKeep uses the microphone so you can add items by voice with Mili.",
          "speechRecognitionPermission": "FreshKeep transcribes your voice on-device to add items with Mili."
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
